# Dockerfile for building ExecuTorch WebAssembly binaries
# This container includes Emscripten and all dependencies needed to build executor_runner.js/.wasm

FROM ubuntu:22.04

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    python3 \
    python3-pip \
    wget \
    curl \
    ninja-build \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install CMake 3.29+ via pip (ExecuTorch requirement)
# Ubuntu 22.04 ships with CMake 3.22, but we need 3.29+
# Using pip ensures we get a recent version that works on ARM64
RUN pip3 install --no-cache-dir cmake>=3.29.0

# Install Emscripten
# Use version 4.0.10 (same as ExecuTorch CI) for WASM SIMD support
ENV EMSDK_VERSION=4.0.10
ENV EMSDK=/opt/emsdk
WORKDIR /opt
RUN git clone https://github.com/emscripten-core/emsdk.git && \
    cd emsdk && \
    ./emsdk install ${EMSDK_VERSION} && \
    ./emsdk activate ${EMSDK_VERSION}

# Set up Emscripten environment variables
ENV PATH="${EMSDK}:${EMSDK}/upstream/emscripten:${PATH}"
# EMSDK_NODE will be set dynamically by emsdk_env.sh

# Clone ExecuTorch repository with submodules
ENV EXECUTORCH_VERSION=v1.4.0
WORKDIR /workspace
RUN git clone --branch ${EXECUTORCH_VERSION} --depth 1 --recurse-submodules --shallow-submodules https://github.com/pytorch/executorch.git

# Patch XNNPACK to remove the -mfp16 flag that causes build failures on ARM64 hosts
# The -mfp16 flag is for ARM native FP16 support, not needed for WASM builds
# See: https://github.com/pytorch/executorch/issues/XXXX
WORKDIR /workspace/executorch
RUN sed -i 's/ADD_COMPILE_OPTIONS("-mfp16")/#ADD_COMPILE_OPTIONS("-mfp16") # Disabled for WASM builds/' \
    backends/xnnpack/third-party/XNNPACK/CMakeLists.txt && \
    echo "Patched XNNPACK CMakeLists.txt to remove -mfp16 flag"

# Install minimal Python dependencies for Wasm build

# Upgrade pip, setuptools, wheel first
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel

# Install torch (needed for torchgen module used by code generation scripts)
# Install only CPU version to save space
RUN pip3 install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Install other dependencies
RUN pip3 install --no-cache-dir pyyaml

# Make executorch package importable without building C++ extensions
# This allows Python scripts like gen_oplist.py to import executorch modules
ENV PYTHONPATH="/workspace/executorch:${PYTHONPATH}"

# Build script that will be executed
COPY scripts/build_wasm_in_container.sh /build_wasm.sh
RUN chmod +x /build_wasm.sh

# Default command: build Wasm binaries
CMD ["/build_wasm.sh"]

# Build outputs will be in /workspace/executorch/cmake-out-wasm/
# Mount a volume to /output to copy binaries out
VOLUME ["/output"]
