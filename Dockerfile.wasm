# Dockerfile for building ExecuTorch WebAssembly binaries
# This container includes Emscripten and all dependencies needed to build executor_runner.js/.wasm

FROM ubuntu:22.04

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    python3 \
    python3-pip \
    wget \
    curl \
    ninja-build \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install CMake 3.29+ via pip (ExecuTorch requirement)
# Ubuntu 22.04 ships with CMake 3.22, but we need 3.29+
# Using pip ensures we get a recent version that works on ARM64
RUN pip3 install --no-cache-dir cmake>=3.29.0

# Install Emscripten
# Use version 4.0.10 (same as ExecuTorch CI) for WASM SIMD support
ENV EMSDK_VERSION=4.0.10
ENV EMSDK=/opt/emsdk
WORKDIR /opt
RUN git clone https://github.com/emscripten-core/emsdk.git && \
    cd emsdk && \
    ./emsdk install ${EMSDK_VERSION} && \
    ./emsdk activate ${EMSDK_VERSION}

# Set up Emscripten environment variables
ENV PATH="${EMSDK}:${EMSDK}/upstream/emscripten:${PATH}"
# EMSDK_NODE will be set dynamically by emsdk_env.sh

# Clone ExecuTorch repository with submodules
ENV EXECUTORCH_VERSION=v1.5.0
WORKDIR /workspace
RUN git clone --branch ${EXECUTORCH_VERSION} --depth 1 --recurse-submodules --shallow-submodules https://github.com/pytorch/executorch.git

# Build XNNPACK without the WebAssembly FP16 (half-precision) feature.
#
# XNNPACK passes -mfp16 to every Emscripten build. A module compiled that way
# contains FP16 opcodes, and a browser that has not shipped the proposal
# rejects the whole module at instantiation, not just the FP16 kernels. So:
#   1. drop the -mfp16 flag, and
#   2. drop the micro-kernels that cannot compile without it.
# ExecuTorch 1.5.0's XNNPACK pin added (2)'s kernels; they are listed for
# compilation unconditionally and fail with "requires target feature 'fp16'".
# The list is derived from the sources so it follows the XNNPACK pin.
#   3. repoint the two that the plain relaxed-SIMD config still selects.
# With XNNPACK_ENABLE_WASMRELAXEDSIMDFP16 off (build_wasm_in_container.sh sets
# it) the config stops choosing FP16 kernels, except f16 cosine and sine: their
# "f32acc" relaxed-SIMD kernels also convert through FP16 intrinsics, so they
# are in (2)'s list and would be undefined at link time. Use the scalar
# kernels every other non-FP16 target falls back to. A future pin that adds
# another such reference fails the link with the symbol name.
WORKDIR /workspace/executorch
RUN cd backends/xnnpack/third-party/XNNPACK && \
    sed -i 's/ADD_COMPILE_OPTIONS("-mfp16")/#ADD_COMPILE_OPTIONS("-mfp16") # Disabled for WASM builds/' \
        CMakeLists.txt && \
    fp16_headers=$(grep -rlE 'wasm_f16x8_' src --include='*.h' | xargs -r -n1 basename | paste -sd'|') && \
    { grep -rlE 'wasm_f16x8_' src --include='*.c'; \
      [ -n "$fp16_headers" ] && grep -rlE "(${fp16_headers})" src --include='*.c'; } | sort -u > /tmp/wasm_fp16_srcs.txt && \
    while read -r src; do \
        sed -i -E "\|^  ${src}\)\$|s|^  .*\)\$|  )|; \|^  ${src}\$|d" cmake/gen/wasmrelaxedsimd_microkernels.cmake; \
    done < /tmp/wasm_fp16_srcs.txt && \
    sed -i -E '/xnn_f16_f32acc_v(cos|sin)_ukernel__wasmrelaxedsimd_poly_3_u8/{s/__wasmrelaxedsimd_poly_3_u8/__scalar_poly_3_u4/;n;s/element_tile = 8;/element_tile = 4;/}' \
        src/configs/unary-elementwise-config.c && \
    ! grep -q 'xnn_f16_f32acc_v\(cos\|sin\)_ukernel__wasmrelaxedsimd' src/configs/unary-elementwise-config.c && \
    echo "Patched XNNPACK: removed -mfp16 and $(wc -l < /tmp/wasm_fp16_srcs.txt) FP16-only Wasm micro-kernels"

# Install minimal Python dependencies for Wasm build

# Upgrade pip, setuptools, wheel first
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel

# Install torch (needed for torchgen module used by code generation scripts)
# Install only CPU version to save space
RUN pip3 install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Install other dependencies
RUN pip3 install --no-cache-dir pyyaml

# Make executorch package importable without building C++ extensions
# This allows Python scripts like gen_oplist.py to import executorch modules
ENV PYTHONPATH="/workspace/executorch:${PYTHONPATH}"

# Build script that will be executed
COPY scripts/build_wasm_in_container.sh /build_wasm.sh
RUN chmod +x /build_wasm.sh

# Default command: build Wasm binaries
CMD ["/build_wasm.sh"]

# Build outputs will be in /workspace/executorch/cmake-out-wasm/
# Mount a volume to /output to copy binaries out
VOLUME ["/output"]
